@startuml
hide circle
entity departments { *department_id : INT <<PK>> -- department_name : VARCHAR created_at : DATE }
entity jobs { *job_id : INT <<PK>> -- department_id : INT <<FK>> job_title : VARCHAR target_headcount : INT base_salary_min : DECIMAL base_salary_max : DECIMAL }
entity employees { *employee_id : INT <<PK>> -- job_id : INT <<FK>> department_id : INT <<FK>> full_name : VARCHAR email : VARCHAR base_salary : DECIMAL hire_date : DATE resignation_date : DATE status : ENUM }
entity employment_events { *event_id : BIGINT <<PK>> -- employee_id : INT <<FK>> event_type : ENUM event_date : DATE description : VARCHAR }
entity rewards_disciplines { *record_id : BIGINT <<PK>> -- employee_id : INT <<FK>> type : ENUM amount : DECIMAL record_date : DATE }
entity attendance_records { *attendance_id : BIGINT <<PK>> -- employee_id : INT <<FK>> work_date : DATE work_days : DECIMAL status : ENUM }
entity leave_records { *leave_id : BIGINT <<PK>> -- employee_id : INT <<FK>> start_date : DATE end_date : DATE total_days : DECIMAL }
entity overtime_records { *ot_id : BIGINT <<PK>> -- employee_id : INT <<FK>> work_date : DATE hours : DECIMAL hourly_rate : DECIMAL multiplier : DECIMAL }
entity payrolls { *payroll_id : BIGINT <<PK>> -- employee_id : INT <<FK>> pay_month : INT pay_year : INT base_salary : DECIMAL overtime_pay : DECIMAL bonus : DECIMAL deduction : DECIMAL net_salary : DECIMAL status : ENUM sent_at : TIMESTAMP }
entity projects { *project_id : INT <<PK>> -- project_name : VARCHAR required_headcount : INT start_date : DATE status : VARCHAR }
entity project_allocations { *allocation_id : BIGINT <<PK>> -- project_id : INT <<FK>> employee_id : INT <<FK>> role_in_project : VARCHAR }
entity users { *user_id : INT <<PK>> -- employee_id : INT <<FK>> username : VARCHAR password_hash : VARCHAR role : ENUM }
entity system_logs { *log_id : BIGINT <<PK>> -- username : VARCHAR action_type : VARCHAR created_at : TIMESTAMP }
departments ||--o{ jobs
departments ||--o{ employees
jobs ||--o{ employees
employees ||--o{ employment_events
employees ||--o{ rewards_disciplines
employees ||--o{ attendance_records
employees ||--o{ leave_records
employees ||--o{ overtime_records
employees ||--o{ payrolls
employees ||--o{ project_allocations
projects ||--o{ project_allocations
employees o|--|| users
@enduml
